<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF121212">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="选择应用"
        android:textSize="15sp"
        android:textStyle="bold"
        android:padding="14dp"
        android:background="#FF1E1E1E"
        android:textColor="#FF80CBC4" />

    <Button
        android:id="@+id/btn_show_all"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="显示全部应用"
        android:textSize="15sp"
        android:textColor="#FFECEFF1"
        android:backgroundTint="#FF263238" />

    <EditText
        android:id="@+id/et_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="2dp"
        android:background="#FF263238"
        android:hint="搜索应用名或包名（忽略大小写）"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:padding="12dp"
        android:singleLine="true"
        android:textColor="#FFECEFF1"
        android:textColorHint="#FF78909C"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/perm_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#FF1E1E1E"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_perm_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="没拿到应用列表？需要开启「获取应用列表」权限"
            android:textSize="13sp"
            android:textColor="#FFFFD54F" />

        <Button
            android:id="@+id/btn_perm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="去开启权限"
            android:textColor="#FFECEFF1"
            android:backgroundTint="#FF37474F" />

        <Button
            android:id="@+id/btn_manual_pkg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="手动输入应用包名"
            android:textColor="#FFECEFF1"
            android:backgroundTint="#FF37474F" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#FF333333"
            android:dividerHeight="1dp"
            android:cacheColorHint="#FF121212"
            android:background="#FF121212" />

        <LinearLayout
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:indeterminate="true"
                android:indeterminateTint="#FF80CBC4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="正在加载应用列表…"
                android:textSize="14sp"
                android:textColor="#FF90A4AE" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
